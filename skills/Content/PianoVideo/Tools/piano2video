#!/usr/bin/env bash
# piano2video — song/audio -> MIDI + sheet music + Synthesia-style piano video.
# Runs the p2v package inside its dedicated venv (create it with Tools/setup.sh).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="${P2V_VENV:-$HOME/.kaya/venvs/piano2video}"
if [[ ! -x "$VENV/bin/python" ]]; then
  echo "piano2video: venv missing at $VENV — run $HERE/setup.sh first" >&2
  exit 1
fi
# cairosvg dlopens libcairo; Homebrew's lib dir isn't on the default macOS search path
export DYLD_FALLBACK_LIBRARY_PATH="${DYLD_FALLBACK_LIBRARY_PATH:-/opt/homebrew/lib:/usr/local/lib:/usr/lib}"
export PYTHONWARNINGS="${PYTHONWARNINGS:-ignore}"
cd "$HERE" && exec "$VENV/bin/python" -m p2v.pipeline "$@"
