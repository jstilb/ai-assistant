# ═══════════════════════════════════════════════════════════════════════════════
# Kaya .gitignore - Private Repository
# ═══════════════════════════════════════════════════════════════════════════════
# This file excludes secrets, credentials, and operational data that should
# never be committed, even to a private repo.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# SECRETS & CREDENTIALS (NEVER COMMIT)
# ─────────────────────────────────────────────────────────────────────────────────
.env
.env.*
*.env

# API Keys & Certificates
*.pem
*.key
*.crt
*.p12
*.pfx
# Precise secret/credential file names. These were once substring globs
# (`*secret*`, `*credential*`, `auth*.json`, ...) that silently hid new source
# files such as SecretInput.ts or credential-input-clients.test.ts.
*.secret
*.secrets
secret.json
secrets.json
secrets.*.json
*-secrets.json
*_secrets.json
credentials.json
credentials.*.json
.credentials.json
client_secret*.json
service-account*.json
api_key
api_keys.json
apikey
apikeys.json
auth.json
oauth.json
oauth_creds.json
*token.json
*tokens.json
# Safety net: broad substring rules still catch stray secret files on the Mac
# (untracked credential dumps, exported keys). Source and docs are re-included
# by extension, so files like SecretInput.ts are never silently hidden.
*secret*
*credential*
auth*.json
oauth*.json
api_key*
!*secret*.ts
!*Secret*.ts
!*credential*.ts
!*Credential*.ts
!*secret*.md
!*Secret*.md
!*credential*.md
!*Credential*.md
!*secret*.txt
.credentials/
.auth/
/credentials/

# ─────────────────────────────────────────────────────────────────────────────────
# OPERATIONAL DATA (Temporary/Regenerable)
# ─────────────────────────────────────────────────────────────────────────────────
# Logs and debug output (Claude Code root dirs are anchored so nested source
# dirs named logs/ debug/ are never hidden)
/logs/
/debug/
MEMORY/**/logs/
*.log
*.log.*

# AppUsageTracker DuckDB cache — regenerable, grows >100MB (GitHub blob limit).
# Was tracked historically; untracked 2026-05-29 to stop bloating/blocking pushes.
MEMORY/AppUsage/events.db
# YouTube Takeout archives + extracted contents — large PERSONAL data
# (watch/search history, Chrome history, addresses, bookmarks, device info).
# Regenerable, never belongs in git. Untracked 2026-05-29.
MEMORY/AppUsage/youtube-takeout-inbox/
MEMORY/AppUsage/youtube-takeout-extracted/

# Shell and session snapshots
shell-snapshots/
session-env/
.current-session

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
paste-cache/

# Telemetry and monitoring data
/telemetry/
/statsig/

# Claude Code internal files
tool-results/
history.jsonl

# Session-specific todos (ephemeral, regenerated each session)
/todos/

# Claude Code session data (ephemeral, regenerated each session)
/backups/
MEMORY/**/backups/
/file-history/
/projects/
plugins/cache/

# ─────────────────────────────────────────────────────────────────────────────────
# EDITOR & OS FILES
# ─────────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# IDE/Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ─────────────────────────────────────────────────────────────────────────────────
# NODE/BUN DEPENDENCIES (Regenerable)
# ─────────────────────────────────────────────────────────────────────────────────
node_modules/
.bun/
bun.lockb
*-bun.lock
# bun.lock is tracked in every project (root and nested) so installs are reproducible.

# ─────────────────────────────────────────────────────────────────────────────────
# LARGE GENERATED FILES
# ─────────────────────────────────────────────────────────────────────────────────
# Bun-compiled bundles (regenerable via bun build)

# Build output
dist/
/build/
/apps/*/build/
.next/
coverage/
*.app/

# Merge/patch leftovers and local databases (tracked *.db files are not affected)
*.orig
*.rej
*.sqlite
*.duckdb
*.db-wal
*.db-shm

# Dogfood screenshots — runtime artifacts, pruned daily by launchd
dogfood-screenshots/

# ─────────────────────────────────────────────────────────────────────────────────
# SETTINGS (Keep base, exclude local overrides)
# ─────────────────────────────────────────────────────────────────────────────────
# settings.json - KEEP (contains identity, not secrets)
# settings.local.json - EXCLUDE (contains session-specific permissions)
settings.local.json

# ─────────────────────────────────────────────────────────────────────────────────
# WORKTREES & NESTED GIT REPOS
# ─────────────────────────────────────────────────────────────────────────────────
# Git worktrees have their own branches — never stage into main
worktrees/

# ─────────────────────────────────────────────────────────────────────────────────
# CACHE FILES (Regenerable)
# ─────────────────────────────────────────────────────────────────────────────────
/cache/
MEMORY/**/cache/
.cache/
*-cache.json
stats-cache.json

# Python bytecode cache (regenerable) — flagged unresolved since the
# 2026-03-12 SkillAudit; committed .pyc files found under
# skills/Development/CreateSkill/Tools/__pycache__/ (fable-audit batch2).
__pycache__/
*.pyc

# ─────────────────────────────────────────────────────────────────────────────────
# CLAUDE CODE IDE INTEGRATION (session-specific lock files; /tasks/ is ignored below)
# ─────────────────────────────────────────────────────────────────────────────────
/ide/

# ─────────────────────────────────────────────────────────────────────────────────
# PLUGINS (Fetched from remote, not source)
# ─────────────────────────────────────────────────────────────────────────────────
plugins/install-counts-cache.json
plugins/installed_plugins.json
plugins/known_marketplaces.json
plugins/marketplaces/

# Claude Code CLI binary's own background-worker supervisor state (bg Bash-tool
# worker pool + auth-token refresh) — NOT a Kaya subsystem, only accidentally
# git-tracked via a broad "snapshot runtime state" commit (74cb33e4a, 2026-06-21).
# The claude binary owns this directory's lifecycle; never delete the on-disk
# files, only keep them out of version control. Mirrors events.db/Takeout
# practice above. (Rationale: the 2026-07-17 fable-audit infra-cleanup report, in git history.)
/daemon/

# ─────────────────────────────────────────────────────────────────────────────────
# TRANSIENT STATE
# ─────────────────────────────────────────────────────────────────────────────────
MEMORY/VALIDATION/
MEMORY/daemon/cron/*.backup.json
# Transient per-job run-lock files (lib/cron/RunLock.ts) — exist only while a
# wrapper is executing; committing one would snapshot meaningless state.
MEMORY/daemon/cron/locks/
# (MEMORY/EVALS/ — incl. live-fixture-runs/ fixture-net accuracy records — and
# MEMORY/State/ are ignored wholesale in the RUNTIME CHURN section below.)

# ─────────────────────────────────────────────────────────────────────────────────
# AUTO-GENERATED PLANS (temp plan mode files with random names)
# ─────────────────────────────────────────────────────────────────────────────────
# Matches only DIRECT children of plans/ (adjective-verb-noun.md names written by
# plan mode). Hand-written plans go in a subdirectory (plans/<topic>/...), which
# this rule does not touch. See plans/README.md.
plans/*-*-*.md

# Design-project screenshot iterations (shoot.ts output while building). Commit only
# the final set and the shots a decision doc links to; build iterations stay local.
docs/design/**/shots/build-*/
docs/design/**/shots/iter-*/
docs/design/**/shots/wip*/
docs/design/**/shots/tmp*/

# ─────────────────────────────────────────────────────────────────────────────────
# GENERATED INDEXES & HISTORY
# ─────────────────────────────────────────────────────────────────────────────────
skills/skill-index.json

# ─────────────────════════════════════════════════════════════════════════════════
# WHAT IS TRACKED (For Reference)
# ─────────────────────────────────────────────────────────────────────────────────
# The following ARE tracked for backup/history:
# - skills/           (all skills including _USERCONTEXT, _DTR, _RALPHLOOP)
# - hooks/            (lifecycle handlers)
# - bin/              (maintenance scripts)
# - MEMORY/           (session history, learnings - YOUR BACKUP)
# - context/          (personal context files - YOUR BACKUP)
# - plans/            (planning documents)
# - settings.json     (identity config - no secrets)
# - CLAUDE.md         (entry point)
# - install.ts        (setup script)
# NOTE: path is skills/Productivity/LucidTasks (the pre-Productivity/ rules below
# were stale and silently tracked the live DB — committing a WAL/shm or replacing
# the .db inode under the always-on BoardServer caused SQLITE_IOERR_VNODE outages).
skills/Productivity/LucidTasks/Data/*.db
# keep the old (now-empty) paths too, harmless if the dir never returns
skills/LucidTasks/Data/*.db
# LifeOS SQLite mirror (Phase 1 overhaul — mq5vmjmh-8rf97i)
skills/Productivity/LifeOS/Data/*.db

# ─────────────────────────────────────────────────────────────────────────────────
# SCREENSHOTS (Browser automation artifacts, large binaries)
# ─────────────────────────────────────────────────────────────────────────────────
**/screenshots/*.png

# ─────────────────────────────────────────────────────────────────────────────────
# KNOWLEDGE GRAPH — relocated to the shared out-of-repo store (~/.kaya/graph) so a
# branch checkout/reset/discard can never touch graph learnings; every concurrent
# worktree session + cron shares one live graph. History via bin/backup-graph.ts.
# ─────────────────────────────────────────────────────────────────────────────────
MEMORY/GRAPH/
# Graph ingester cursors — now shared at ~/.kaya/graph/State/ (were branch-local).
skills/Intelligence/Graph/State/decision-ingester-cursor.json
skills/Intelligence/Graph/State/last-capture.json

# ─────────────────────────────────────────────────────────────────────────────────
# RUNTIME STATE — high-churn ephemeral subtrees relocated to the shared out-of-repo
# store (~/.kaya/runtime) so git stops seeing churn and a branch checkout/reset/
# discard can never touch live runtime state. Each subtree is symlinked from its
# canonical path (MEMORY/<sub>) into the shared store by bin/migrate-runtime-to-shared.sh.
# ─────────────────────────────────────────────────────────────────────────────────
# No trailing slash: these are symlinks (to ~/.kaya/runtime) after activation, and a
# trailing-slash pattern matches only real directories, not symlinks. No-slash matches
# the symlink AND a directory (if ever recreated).
MEMORY/MONITORING
MEMORY/QUEUES
MEMORY/NOTIFICATIONS
MEMORY/EVAL_SIGNALS
# Pipeline/work state now lives in the transactional ~/.kaya/runtime/pipeline.db
# (Phase 4 cutover). work-queue.json was git-tracked (R2): branch checkout /
# reconciliation could clobber live queue state. Untracked + ignored here so it
# can never be overwritten by a git operation again.
MEMORY/WORK
# .kaya/ — out-of-repo shared store (runtime/graph/memory); never belongs in git.
# Tests that pin KAYA_HOME to a temp dir create .kaya/ subdirs there; this
# prevents accidental git-tracking of test-generated .kaya artifacts.
.kaya/

# ─────────────────────────────────────────────────────────────────────────────────
# SECURITY SCAN REPORTS (E1 — secret-scan-honest, 2026-07-07)
# ─────────────────────────────────────────────────────────────────────────────────
# Per-finding trufflehog scan detail (file/detector/line — never secret
# values, but still forensic/operational data with no business being
# version-controlled). See SecurityAuditor.ts.
MEMORY/security/

# ─────────────────────────────────────────────────────────────────────────────────
# BROWSER STATES (Chrome-migration S1 hygiene, 2026-07-12)
# ─────────────────────────────────────────────────────────────────────────────────
# Saved browser sessions (cookies/storage) live here — test-state leftovers and
# LIVE authenticated sessions alike. Never git-track by default; an accidental
# `git add -A` here would commit real cookies. Intentional future commits use
# `git add -f`.
MEMORY/browser-states/*.json
# JobEngine's cookie jars predate the 07-12 sweep and live at a separate,
# older path convention (T4-01, 2026-08-01) — same rationale as above.
skills/Commerce/JobSearch/State/browser-cookies/*.json

# ─────────────────────────────────────────────────────────────────────────────────
# ANKI COLLECTION BACKUPS (anki-deck-review-20260724 S0)
# ─────────────────────────────────────────────────────────────────────────────────
# `apy backup` .apkg exports of the live Anki collection. Multi-MB binary blobs
# (245MB+ with media) that this repo's whole-tree auto-commit would otherwise
# swallow. Restore artifacts, not source.
MEMORY/Life/anki-backups/

# Image-occlusion composites for the anki deck review (S0.4 mechanism).
# 22MB of derived PNGs, regenerated from the live collection in ~3s by
# `tools/ioe_render.py --all`. The 3 S0-proof renders ARE committed, as the
# evidence that the S6 gate passed.
plans/anki-deck-review-20260724/media/ioe/
plans/anki-deck-review-20260724/media/s3/

# Bank/brokerage statement exports dropped for FinanceImport ingestion — raw
# PERSONAL financial data, never in version control. The Data/README.md
# contract doc IS committed. Mirrors events.db/Takeout policy.
USER/FINANCES/Data/*
!USER/FINANCES/Data/README.md

# Evals setup-ablation profile dirs (Tools/Ablation/ProfileBuilder.ts): since
# 2026-10-11 AblationRunner builds them OUTSIDE the repo
# (~/.kaya/runtime/ablations/<runId>/profiles). This line only guards LEGACY
# in-repo trees from older runs — they carry a snapshot COPY of the auto-memory
# dir, which must never ride into version control (public mirror). report.md /
# matrix.json / cells/ of a run ARE committable evidence.
skills/Development/Evals/Results/ablations/*/profiles/

# ─────────────────────────────────────────────────────────────────────────────────
# RUNTIME CHURN UNTRACKED (dirty-tree remediation, 2026-09-21)
# ─────────────────────────────────────────────────────────────────────────────────
# Investigation of 4,722 dirty paths found these tracked files are pure job-written
# state: append-only ledgers, regenerated digests, daily audio, live cursors and
# lock files. None is hand-edited; all churned on every run and were clobbered by
# merge syncs. The memory BACKUP (MEMORY/entries, MEMORY/archive, MEMORY/LEARNING,
# briefings/knowledge/task reports) stays tracked on purpose. Untracked with
# `git rm --cached` + staged-set-verified bare commit on main (see
# ~/.kaya/memory/project_remediation_s1s5_executed_20260721.md).
MEMORY/daemon/cron/run-ledger.jsonl
MEMORY/daemon/cron/run-ledger.*.jsonl
MEMORY/daemon/cron/reconciliation.jsonl
MEMORY/daemon/cron/logs/
MEMORY/daemon/message-queue.json
# Memory-store derived indexes — fully rebuildable via `bun lib/core/MemoryStore.ts rebuild`.
MEMORY/index.json
MEMORY/dedup-hashes.json
# All of MEMORY/State is transient (markers, streak counters, locks, cursors incl. a
# live Plaid cursor in lifeos-source-cursors.json).
MEMORY/State/
MEMORY/AutoMaintenance/*.jsonl
MEMORY/AutoMaintenance/*.jsonl.bak-*
MEMORY/AutoMaintenance/health-state.json
MEMORY/AutoMaintenance/health-state.*.backup.json
MEMORY/AutoMaintenance/health-state.json.bak-*
MEMORY/BRIEFINGS/briefing-voice.ogg
MEMORY/BRIEFINGS/.sent-*
MEMORY/DIGESTS/metrics.jsonl
MEMORY/LEARNING/SIGNALS/*.jsonl
MEMORY/LEARNING/SIGNALS/*.jsonl.bak-*
MEMORY/VOICE/voice-events.jsonl
MEMORY/AUTOINFO/digests/*.json
MEMORY/Commerce/instacart-last-run.json
MEMORY/shopping-audit.jsonl
MEMORY/Life/anki-runs.jsonl
# Subagent output auto-dumps (hooks/AgentOutputCapture.hook.ts) and per-run eval
# samples — regenerated per run, not golden artifacts.
MEMORY/research/
MEMORY/EVALS/
MEMORY/CONTENT/
MEMORY/AutonomousWork/live-verification/
MEMORY/Intelligence/argumentmapper-runs.jsonl
MEMORY/AppUsage/calibration/
skills/Development/Evals/Results/**/run_*.json
skills/Development/Evals/Transcripts/
skills/Productivity/CalendarAssistant/[Dd]ata/scheduler-state.json
skills/Productivity/CalendarAssistant/[Dd]ata/calendar-writes.jsonl
skills/Productivity/LucidTasks/Data/automation-state.json
skills/Productivity/LucidTasks/Data/daily-stats.jsonl
skills/Commerce/JobSearch/State/applications.jsonl
skills/Commerce/JobSearch/State/gmail-sync-state.json
skills/Content/MoodBoard/[Dd]ata/boards.*.backup.json
skills/Content/ContentAggregator/State/
# Repo-root timestamps, agent rosters and worktree registry written by hooks/CLI.
.last-cleanup
.last-update-result.json
plugins/.last_inuse_sweep
hooks/lib/.active-agents.json
worktrees/state.json
daemon.lock
daemon.status.json
# Claude Code session data siblings of the already-ignored todos/ projects/ etc.
# Anchored to the repo root: core.ignorecase=true here, so an unanchored
# `tasks/` would also match MEMORY/TASKS/ and `jobs/` the cron job yamls.
/sessions/
/feedback/
/tasks/
/chrome/
/jobs/*
/data/pairs.jsonl
/data/lucidtasks.db
/tmp/
# Scratch dumps: undo snapshots (4 MB index copies) and watch-later exports.
.scratch/context-integrity/undo-*/
# Source (SummarizeSnapshot.ts, runbook, fixtures/) stays tracked; only the large raw dumps are ignored.
.scratch/youtube-curation/assets/wl-snapshot-*.json
.scratch/youtube-curation/assets/wl-scrape-*-raw.json
.scratch/youtube-curation/assets/history-sample-*.json
!.scratch/youtube-curation/assets/fixtures/
!.scratch/youtube-curation/assets/fixtures/**

# Claude Code runtime state (2026-10-26 shared-tree sweep): written by the harness, not Kaya
plugins/plugin-directory-cache-v2.json*
plugins/store/
plugins/synced/
skills/synced/
policy-limits.json
policy-limits.json.stamp.json
remote-settings.json

# Hygiene sweep (2026-11-04)
# Pre-migration snapshots: git history keeps them; never re-commit.
/.backups/
# Per-test scratch dirs left behind by crashed test runs.
__test_tmp*/
# Paths built from an unset env var (e.g. "$UNDEFINED/.cache") — a bug signal, never data.
/undefined/
# Empty stderr captures from tool runs.
*.err

# ─────────────────────────────────────────────────────────────────────────────────
# RUNTIME STATE UNTRACKED (repo-hygiene sweep, 2026-11-04)
# ─────────────────────────────────────────────────────────────────────────────────
# Written by daemons/jobs on every run; all readers tolerate absence (verified).
# Worktree liveness heartbeats (lib/core/WorktreeManager.ts; legacy in-repo fallback
# of runtimeDir() — normally ~/.kaya/runtime/locks).
MEMORY/locks/
# Telegram bot logs/sessions (outbound ledger, per-session transcripts). context.md stays tracked.
MEMORY/TELEGRAM/outbound.jsonl*
MEMORY/TELEGRAM/sessions/
MEMORY/TELEGRAM/conversations/
# Daemon runtime state/logs. MEMORY/daemon/cron/manifests/ is live config and stays tracked;
# s4-applied-labels.jsonl / s4-migration-diff.md are historical migration records and stay tracked.
MEMORY/daemon/daemon.jsonl*
MEMORY/daemon/daemon-state.json
MEMORY/daemon/*.lock
MEMORY/daemon/*.heartbeat
# JobSearch dated scan dumps (regenerated by JobScanner; readLatestScanResults only reads <=2 days).
skills/Commerce/JobSearch/State/scan-results/
# TechDebtAuditor weekly full-registry dumps (never read back; writer keeps the newest 4 on disk).
MEMORY/AutoMaintenance/tech-debt/
# Caches / append logs
MEMORY/stagehand-cache/
MEMORY/ACTIVATION/activation-log.jsonl
# Mac-only runtime data the remote cleanup could not see (found at merge time, 2026-11-04).
# The old unanchored backups/, logs/, projects/ and history/*.jsonl rules hid these paths.
/MEMORY/PROJECTS/registry.json
/USER/TELOS/backups/
/history/*.jsonl
/skills/Productivity/LifeOS/Data/backups/
/skills/Productivity/LifeOS/logs/
/skills/System/KayaUpgrade/Logs/

# PromptInjectionDefender / SecurityValidator event logs (runtime, per machine)
MEMORY/SECURITY/
