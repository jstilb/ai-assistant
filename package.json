{
  "name": "kaya",
  "private": true,
  "workspaces": [
    "skills/Development/Browser",
    "skills/Data/Apify",
    "skills/Commerce/Instacart",
    "skills/Communication/Telegram/Server",
    "skills/Development/UnixCLI/Tools",
    "skills/Intelligence/VaultGraph/Tools"
  ],
  "scripts": {
    "test": "bun test \"$PWD/lib/core\" \"$PWD/hooks\"",
    "test:core": "bun test lib/core",
    "test:hooks": "bun test hooks",
    "test:skills": "bun test skills",
    "lint:architecture": "bun lib/lint/run-all.ts",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.json",
    "format": "biome format --write .",
    "check": "biome check .",
    "verify": "bun scripts/verify.ts",
    "verify:tests": "bun scripts/verify.ts --tests-only",
    "coverage": "bun scripts/coverage.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@google/genai": "^2.32.0",
    "@toon-format/toon": "^4.4.0",
    "@xenova/transformers": "^2.17.2",
    "csv-parse": "^7.0.2",
    "marked": "^18.1.3",
    "nanoid": "^6.0.2",
    "node-ical": "^0.27.3",
    "openai": "^7.51.0",
    "pdf-lib": "^1.17.1",
    "replicate": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/bun": "1.4.4",
    "playwright": "^1.58.2",
    "typescript": "5.9.3"
  }
